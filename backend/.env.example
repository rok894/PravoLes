# === Local development ===
# SQLite via libsql — no auth token needed locally.
DATABASE_URL="file:./prisma/dev.db"

# === Production (Vercel) ===
# Turso: libsql://<your-db>.turso.io  + DATABASE_AUTH_TOKEN from `turso db tokens create`
# DATABASE_URL="libsql://your-db.turso.io"
# DATABASE_AUTH_TOKEN="eyJ..."

# Vercel Blob — auto-injected when you add a Blob store to the project, but set manually if needed.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Set to "true" on Vercel when backend and frontend live on different origins
# (e.g. pravoles-api.vercel.app vs pravoles.vercel.app). Switches session + CSRF
# cookies to SameSite=None; Secure and drops the __Host- prefix.
# CROSS_SITE_COOKIES="true"

# Stripe — use live keys for production.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Absolute URL of the backend deployment (used to build Stripe checkout redirects etc).
NEXT_PUBLIC_BASE_URL="http://localhost:3001"

# Allowed frontend origin(s) for CORS. Comma-separated list is supported.
# Example for Vercel: "https://pravoles.vercel.app,https://pravoles-git-main-you.vercel.app"
FRONTEND_ORIGIN="http://localhost:5173"

# Public frontend URL used in admin emails / UI links.
NEXT_PUBLIC_FRONTEND_URL="http://localhost:5173"

# SMTP (nodemailer) — set these to enable transactional email in production.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="PravoLes <info@pravoles.si>"
